---
import { url } from '../utils/url';
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <section class="wrap nf">
    <div class="big grad-text">404</div>
    <h2>This page doesn't exist</h2>
    <a class="btn primary" href={url('/')}>Back to home</a>
  </section>
</Base>

<style>
  .nf { text-align: center; padding: 110px 20px; }
  .big { font-size: 6rem; font-weight: 800; line-height: 1; }
</style>
