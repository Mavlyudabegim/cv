---
import { url } from '../../utils/url';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { profile } from '../../data/cv';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const d = project.data;
---
<Base title={`${d.title} — ${profile.name}`} description={d.summary}>
  <article class={`wrap accent-${d.color}`}>
    <a class="back" href={url('/#projects')}><Icon name="back" />All projects</a>
    <header class="card">
      <div class="big">
        {d.metric ?? d.label}
        {d.metric && <small>{d.metricLabel}</small>}
      </div>
      <h1>{d.title}</h1>
      <p class="summary">{d.summary}</p>
      <div class="pill-row">{d.tags.map((t) => <span class="pill">{t}</span>)}</div>
      {d.repo && (
        <div class="btns"><a class="btn ghost" href={d.repo} target="_blank" rel="noopener"><Icon name="github" />View code</a></div>
      )}
    </header>
    <div class="card body">
      <Content />
    </div>
  </article>
</Base>

<style>
  article { padding: 48px 20px 30px; max-width: 820px; }
  .accent-violet { --accent: #7c3aed; } .accent-pink { --accent: #db2777; } .accent-teal { --accent: #0d9488; }
  .accent-amber { --accent: #d97706; } .accent-blue { --accent: #2563eb; }
  .back { display: inline-flex; align-items: center; gap: 6px; text-decoration: none; color: var(--muted); font-weight: 600; font-size: .92rem; margin-bottom: 20px; }
  .back:hover { color: var(--violet); }
  .back :global(svg) { width: 16px; height: 16px; }
  header { position: relative; overflow: hidden; }
  header::before { content: ""; position: absolute; inset: 0 0 auto 0; height: 6px; background: var(--accent); }
  .big { font-size: 2.6rem; font-weight: 800; color: var(--accent); line-height: 1; margin-top: 6px; }
  .big small { font-size: .95rem; font-weight: 600; color: var(--muted); margin-left: 8px; }
  h1 { font-size: clamp(1.7rem, 4vw, 2.4rem); line-height: 1.15; margin: 16px 0 10px; }
  .summary { color: var(--muted); font-size: 1.08rem; }
  .btns { margin-top: 20px; }
  .body { margin-top: 20px; }
  .body :global(h2) { font-size: 1.3rem; margin: 26px 0 10px; }
  .body :global(h2:first-child) { margin-top: 0; }
  .body :global(p), .body :global(li) { color: var(--muted); }
  .body :global(strong) { color: var(--text); }
  .body :global(ul), .body :global(ol) { margin: 8px 0 8px 22px; }
  .body :global(li) { margin-bottom: 6px; }
  .body :global(a) { color: var(--violet); }
  .body :global(img) { max-width: 100%; border-radius: 12px; }
  .body :global(table) { width: 100%; border-collapse: collapse; margin: 14px 0; font-size: .93rem; display: block; overflow-x: auto; }
  .body :global(th), .body :global(td) { padding: 9px 12px; border-bottom: 1px solid var(--line); text-align: left; vertical-align: top; }
  .body :global(th) { color: var(--text); font-weight: 700; background: color-mix(in srgb, var(--violet) 8%, transparent); }
  .body :global(td) { color: var(--muted); }
  .body :global(pre) { padding: 16px; border-radius: 12px; overflow-x: auto; margin: 12px 0; }
</style>
