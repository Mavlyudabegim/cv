---
import Icon from './Icon.astro';
import { languages, awards } from '../data/cv';
---
<section id="languages">
  <div class="wrap">
    <div class="eyebrow reveal">Languages &amp; awards</div>
    <h2 class="reveal">Languages</h2>
    <div class="langs">
      {languages.map((l) => (
        <div class="card reveal">
          <b>{l.name} <span>{l.label}</span></b>
          <div class="bar"><i style={`--w:${l.level}%`}></i></div>
        </div>
      ))}
    </div>
    {awards.map((a) => (
      <div class="card award reveal">
        <span class="ico bg-amber"><Icon name="medal" /></span>
        <div><h3>{a.title}</h3><p>{a.detail}</p></div>
      </div>
    ))}
  </div>
</section>

<style>
  .langs { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 16px; }
  b { display: flex; justify-content: space-between; margin-bottom: 10px; }
  b span { color: var(--muted); font-weight: 600; font-size: .88rem; }
  .bar { height: 9px; border-radius: 9px; background: var(--line); overflow: hidden; }
  .bar i { display: block; height: 100%; border-radius: 9px; background: var(--grad); width: 0; transition: width 1.2s ease; }
  .card:global(.in) .bar i, :global(.no-js) .bar i { width: var(--w); }
  .award { display: flex; align-items: center; gap: 18px; margin-top: 18px; }
  .award .ico { width: 52px; height: 52px; border-radius: 14px; }
  .award .ico :global(svg) { width: 26px; height: 26px; }
  h3 { font-size: 1.1rem; }
  p { color: var(--muted); }
  @media (prefers-reduced-motion: reduce) { .bar i { transition: none; } }
</style>
