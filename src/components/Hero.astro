---
import Icon from './Icon.astro';
import { profile } from '../data/cv';

const [first, ...rest] = profile.name.split(' ');
---
<header class="hero" id="top">
  <div class="blob b1"></div><div class="blob b2"></div><div class="blob b3"></div>
  <div class="wrap">
    <div class="badge"><span class="dot"></span> {profile.availability}</div>
    <h1>Hi, I'm <span class="grad-text">{first} {rest.join(' ')}</span></h1>
    <p class="tagline">{profile.tagline}</p>
    <div class="meta">
      <span><Icon name="pin" />{profile.location}</span>
      <span><Icon name="cap" />{profile.degreeLine}</span>
      <span><Icon name="globe" />{profile.relocation}</span>
    </div>
    <div class="btns">
      <a class="btn primary" href={profile.cvFile} download><Icon name="download" />Download CV</a>
      <a class="btn ghost" href="#contact">Get in touch</a>
    </div>
  </div>
</header>

<style>
  .hero { position: relative; overflow: hidden; padding: 90px 0 80px; }
  .blob { position: absolute; border-radius: 50%; filter: blur(70px); opacity: .45; z-index: 0; animation: float 14s ease-in-out infinite; }
  .b1 { width: 380px; height: 380px; background: #7c3aed; top: -120px; left: -80px; }
  .b2 { width: 320px; height: 320px; background: #ec4899; top: 40px; right: -90px; animation-delay: -5s; }
  .b3 { width: 260px; height: 260px; background: #14b8a6; bottom: -140px; left: 40%; animation-delay: -9s; }
  @keyframes float { 0%, 100% { transform: translate(0, 0); } 50% { transform: translate(30px, -25px); } }
  .wrap { position: relative; z-index: 1; }
  .badge {
    display: inline-flex; align-items: center; gap: 8px; padding: 6px 14px; border-radius: 999px;
    background: var(--surface); border: 1px solid var(--line); font-size: .85rem; font-weight: 600; box-shadow: var(--shadow);
  }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: #22c55e; box-shadow: 0 0 0 4px rgba(34, 197, 94, .2); }
  h1 { font-size: clamp(2.2rem, 6vw, 3.8rem); line-height: 1.08; font-weight: 800; letter-spacing: -.02em; margin: 22px 0 14px; }
  .tagline { font-size: clamp(1.05rem, 2.4vw, 1.3rem); color: var(--muted); max-width: 680px; }
  .meta { display: flex; flex-wrap: wrap; gap: 10px 22px; margin: 22px 0 30px; color: var(--muted); font-size: .95rem; }
  .meta span { display: inline-flex; align-items: center; gap: 7px; }
  .meta :global(svg) { width: 17px; height: 17px; flex-shrink: 0; }
  @media print { .blob { display: none; } }
</style>
