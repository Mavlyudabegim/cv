---
import { url } from '../utils/url';
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const accents: Record<string, string> = { violet: '#7c3aed', pink: '#db2777', teal: '#0d9488', amber: '#d97706', blue: '#2563eb' };
---
<section id="projects">
  <div class="wrap">
    <div class="eyebrow reveal">Projects</div>
    <h2 class="reveal">Selected projects</h2>
    <div class="grid">
      {projects.map((p) => (
        <div class="card project reveal" style={`--accent:${accents[p.data.color]}`}>
          <div class:list={['big', { word: !p.data.metric }]}>
            {p.data.metric ?? p.data.label}
            {p.data.metric && <small>{p.data.metricLabel}</small>}
          </div>
          <h3>{p.data.title}</h3>
          <p>{p.data.summary}</p>
          <div class="pill-row">{p.data.tags.map((t) => <span class="pill">{t}</span>)}</div>
          <div class="actions">
            <a class="more" href={url(`/projects/${p.id}/`)}>Read more <Icon name="arrow" /></a>
            {p.data.demo && <a class="demo" href={p.data.demo} target="_blank" rel="noopener">Open live <Icon name="external" /></a>}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; }
  @media (max-width: 720px) { .grid { grid-template-columns: 1fr; } }
  .project { position: relative; overflow: hidden; text-decoration: none; display: flex; flex-direction: column; transition: transform .25s; }
  .project:hover { transform: translateY(-4px); }
  .project::before { content: ""; position: absolute; inset: 0 0 auto 0; height: 5px; background: var(--accent); }
  .big { font-size: 2.2rem; font-weight: 800; color: var(--accent); line-height: 1; }
  .big.word { font-size: 1.6rem; }
  .big small { font-size: .85rem; font-weight: 600; color: var(--muted); margin-left: 6px; }
  h3 { margin: 14px 0 8px; font-size: 1.1rem; }
  p { color: var(--muted); font-size: .95rem; }
  .actions { margin-top: auto; padding-top: 16px; display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .more { display: inline-flex; align-items: center; gap: 6px; font-weight: 600; font-size: .9rem; color: var(--accent); text-decoration: none; }
  .more::after { content: ""; position: absolute; inset: 0; }
  .demo { position: relative; z-index: 1; display: inline-flex; align-items: center; gap: 6px; padding: 7px 14px; border-radius: 999px; background: var(--accent); color: #fff; font-weight: 600; font-size: .85rem; text-decoration: none; transition: filter .2s; }
  .demo:hover { filter: brightness(1.12); }
  .demo :global(svg) { width: 14px; height: 14px; }
  .more :global(svg) { width: 16px; height: 16px; transition: transform .2s; }
  .project:hover .more :global(svg) { transform: translateX(4px); }
</style>
