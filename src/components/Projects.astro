---
import { url } from '../utils/url';
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const accents: Record<string, string> = { violet: '#7c3aed', pink: '#db2777', teal: '#0d9488', amber: '#d97706', blue: '#2563eb' };
---
<section id="projects">
  <div class="wrap">
    <div class="eyebrow reveal">Projects</div>
    <h2 class="reveal">Selected projects</h2>
    <div class="grid">
      {projects.map((p) => (
        <a class="card project reveal" href={url(`/projects/${p.id}/`)} style={`--accent:${accents[p.data.color]}`}>
          <div class:list={['big', { word: !p.data.metric }]}>
            {p.data.metric ?? p.data.label}
            {p.data.metric && <small>{p.data.metricLabel}</small>}
          </div>
          <h3>{p.data.title}</h3>
          <p>{p.data.summary}</p>
          <div class="pill-row">{p.data.tags.map((t) => <span class="pill">{t}</span>)}</div>
          <span class="more">Read more <Icon name="arrow" /></span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; }
  @media (max-width: 720px) { .grid { grid-template-columns: 1fr; } }
  .project { position: relative; overflow: hidden; text-decoration: none; display: flex; flex-direction: column; transition: transform .25s; }
  .project:hover { transform: translateY(-4px); }
  .project::before { content: ""; position: absolute; inset: 0 0 auto 0; height: 5px; background: var(--accent); }
  .big { font-size: 2.2rem; font-weight: 800; color: var(--accent); line-height: 1; }
  .big.word { font-size: 1.6rem; }
  .big small { font-size: .85rem; font-weight: 600; color: var(--muted); margin-left: 6px; }
  h3 { margin: 14px 0 8px; font-size: 1.1rem; }
  p { color: var(--muted); font-size: .95rem; }
  .more { margin-top: auto; padding-top: 16px; display: inline-flex; align-items: center; gap: 6px; font-weight: 600; font-size: .9rem; color: var(--accent); }
  .more :global(svg) { width: 16px; height: 16px; transition: transform .2s; }
  .project:hover .more :global(svg) { transform: translateX(4px); }
</style>
