---
import Icon from './Icon.astro';
import { articles } from '../data/cv';

const items = articles.items;
---
{items.length > 0 && (
  <section id="articles">
    <div class="wrap">
      <div class="eyebrow reveal">Writing</div>
      <h2 class="reveal">{articles.heading}</h2>
      <p class="intro reveal">{articles.intro}</p>
      <ul class="card list reveal">
        {items.map((a) => (
          <li>
            <a href={a.url} target="_blank" rel="noopener">
              <Icon name="book" />
              <span>{a.title}</span>
              <Icon name="external" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .intro { color: var(--muted); margin: -14px 0 20px; max-width: 680px; }
  .list { list-style: none; padding: 8px 26px; }
  li + li { border-top: 1px solid var(--line); }
  a { display: flex; align-items: center; gap: 12px; padding: 14px 0; text-decoration: none; font-weight: 600; color: var(--text); transition: color .2s; }
  a:hover { color: var(--blue); }
  a span { flex: 1; }
  a :global(svg) { width: 18px; height: 18px; flex-shrink: 0; color: var(--blue); }
</style>
