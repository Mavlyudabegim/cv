---
import Icon from './Icon.astro';
import { articles } from '../data/cv';

const items = articles.items;
const show = items.length > 0;
---
{show && (
  <section id="articles">
    <div class="wrap">
      <div class="eyebrow reveal">Writing</div>
      <h2 class="reveal">{articles.heading}</h2>
      <p class="intro reveal">{articles.intro}</p>
      <div class="grid">
        {items.map((a) => (
          <a class="card article reveal" href={a.url} target="_blank" rel="noopener">
            <span class="ico bg-blue"><Icon name="book" /></span>
            <h3>{a.title}</h3>
            <p>{a.summary}</p>
            <div class="pill-row">{a.tags.map((t) => <span class="pill">{t}</span>)}</div>
            <span class="go">Read on Notion <Icon name="external" /></span>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .intro { color: var(--muted); margin: -14px 0 24px; max-width: 680px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 18px; }
  .article { display: flex; flex-direction: column; text-decoration: none; transition: transform .25s; }
  .article:hover { transform: translateY(-4px); }
  h3 { margin: 16px 0 8px; font-size: 1.1rem; line-height: 1.35; }
  p { color: var(--muted); font-size: .95rem; }
  .go { margin-top: auto; padding-top: 16px; display: inline-flex; align-items: center; gap: 6px; font-weight: 600; font-size: .9rem; color: var(--blue); }
  .go :global(svg) { width: 16px; height: 16px; }
</style>
